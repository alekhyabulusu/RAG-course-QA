# =====================================================
# RAG Course QA Project - Environment Variables Template
# =====================================================
# Copy this file to .env and replace with your actual API keys
# NEVER commit .env to version control!

# =====================================================
# REQUIRED API KEYS
# =====================================================

# OpenAI API Configuration (REQUIRED)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_ORG_ID=  # Optional: org-XXXXXXXXXXXXXXXX (leave empty if personal account)

# =====================================================
# VECTOR DATABASE CONFIGURATIONS
# =====================================================

# Pinecone Configuration (Cloud Vector DB)
# Sign up free at: https://app.pinecone.io/
PINECONE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PINECONE_ENVIRONMENT=gcp-starter  # Options: gcp-starter, us-east-1-aws, etc.
PINECONE_INDEX_NAME=course-qa-index

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=course_materials


# Hugging Face Configuration (For LLaMA and other open models)
# Get your token from: https://huggingface.co/settings/tokens

HUGGINGFACE_API_KEY=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Cohere Configuration (Alternative LLM provider)
# Get your key from: https://dashboard.cohere.com/
COHERE_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# =====================================================
# APPLICATION SETTINGS
# =====================================================

# Environment Configuration
APP_ENV=development  # Options: development, production, testing
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Model Parameters
MAX_TOKENS=2000  # Maximum tokens in LLM response
TEMPERATURE=0.7  # LLM temperature (0.0 = deterministic, 1.0 = creative)
TOP_K_RETRIEVAL=5  # Number of chunks to retrieve from vector DB

# =====================================================
# DATABASE CONFIGURATION
# =====================================================

# SQLite Database for storing metadata and user sessions
DATABASE_URL=sqlite:///./data/app.db

# =====================================================
# API SERVER SETTINGS
# =====================================================

# FastAPI Server Configuration
API_HOST=0.0.0.0  # Host to bind to (0.0.0.0 for all interfaces)
API_PORT=8000  # Port for API server
API_RELOAD=true  # Auto-reload on code changes (set to false in production)